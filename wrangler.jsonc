{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-mathintervention",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
